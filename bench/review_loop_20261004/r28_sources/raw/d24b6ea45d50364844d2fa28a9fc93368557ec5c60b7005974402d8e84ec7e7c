                <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function () {
  const SUBSCRIBE_BUTTON = ".subscribe-btn";
  const PAGE = "CFNAI"; // change this value to either 'CFNAI', 'NFCI', 'CFSEC', 'CARTS', or 'BANKNOTES'
  const PERCENT = 0.5; // change value to affect more than X% of users

  // Create a new MutationObserver instance
  const observer = new MutationObserver(function (mutationsList, observer) {
    window.addEventListener("message", (event) => {
      // returns '[iFrameSizer]signup-frame:515:400:resizeParent' on initialization
      // returns '[iFrameSizer]signup-frame:276:400:mutationObserver' on signup completion
      if (event.data.length >= 50) {
        cookieStore.set("email-status", "subscriber");
      }
    });
  });

  // Select the element to observe
  const targetNode = document.querySelector("body");

  // Configure the observer to watch for child list and attribute changes
  const config = { childList: true, attributes: true };

  // Start observing the target node with the specified configuration
  observer.observe(targetNode, config);

  // check subscribe button
  const subscribeButton = document.querySelector(SUBSCRIBE_BUTTON);

  if (subscribeButton) {
    subscribeButton.addEventListener("click", () => currentSubscriber(PERCENT));
  }

  // check cookie for current subscriber then
  // only show to X% of users who aren't subscribed
  const currentSubscriber = async function () {
    const cookie = await cookieStore.get("email-status");
    if (cookie?.value !== "subscriber") {
      let chance = Math.random();
      if (chance <= PERCENT) {
        addScript(PAGE);
      }
    }
  };

  currentSubscriber(PERCENT);
});

// Page = string referring to corresponding PAGE (e.g. NFCI, CFNAI, CFSEC)
// Width (optional) = number referring to width in pixels of overlay; default is 400px
const addScript = function (PAGE, width = 400) {
  // Allows for re-trigger of overlay form by removing localstorage key:value pair set by govDelivery
  let partialMatch = "VVNGUkJDSElDQUdPL";
  // VVNGUkJDSElDQUdPLTM2MDU4
  Object.keys(localStorage).forEach((key) => {
    if (key.match(partialMatch)) {
      localStorage.removeItem(key);
    }
  });

  const signupFormIds = {
    CFNAI: "46502",
    NFCI: "46552",
    CFSEC: "46553",
    CARTS: "47917",
    LABORMARKETINDICATORS: "48058",
    // TEST: "36058",
  };

  const govDeliverySignup = document.createElement("script");
  govDeliverySignup.type = "text/javascript";

  govDeliverySignup.src =
    "https://public.govdelivery.com/assets/SignupOverlay.js";
  govDeliverySignup.setAttribute("data-account-code", "USFRBCHICAGO");
  govDeliverySignup.setAttribute("data-signup-id", signupFormIds[PAGE]);
  govDeliverySignup.setAttribute("async", "");
  govDeliverySignup.setAttribute("data-width", width);

  document.body.appendChild(govDeliverySignup);
};

