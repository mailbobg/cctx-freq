{
  "dry_run": true,
  "dry_run_wallet": 10000,
  "grinding_enable": true,
  "max_open_trades": 6,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "unfilledtimeout": {
    "entry": 3,
    "exit": 2,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "limit",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "stoploss_on_exchange_interval": 60,
    "stoploss_on_exchange_limit_ratio": 0.99
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "trading_mode": "spot",
  "margin_mode": "",
  "dataformat_ohlcv": "feather",
  "use_exit_signal": true,
  "exit_profit_only": false,
  "ignore_roi_if_entry_signal": true,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "timeout": 30000
    },
    "ccxt_async_config": {
      "timeout": 30000
    }
  },
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  },
  "force_entry_enable": true,
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "verbosity": "error",
    "CORS_origins": [
      "http://127.0.0.1:8080",
      "http://localhost:8080",
      "http://127.0.0.1:8089",
      "http://localhost:8089"
    ]
  },
  "telegram": {
    "enabled": false,
    "token": "your_telegram_token",
    "chat_id": "your_telegram_chat_id"
  }
}
