{
  "add_config_files": [
    "common.json",
    "secrets.json",
    "local-network.json"
  ],
  "strategy": "RiskHoldC",
  "bot_name": "c-hold",
  "timeframe": "1d",
  "max_open_trades": 2,
  "db_url": "sqlite:///user_data/tradesv3.c-hold.dryrun.sqlite",
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "exchange": {
    "enable_ws": false,
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": []
  },
  "api_server": {
    "listen_port": 8084
  }
}