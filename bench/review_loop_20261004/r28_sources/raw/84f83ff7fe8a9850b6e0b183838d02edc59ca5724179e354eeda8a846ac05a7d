                <script type="text/javascript">
                
var generatedHolder = document.getElementById('upcoming-data-releases');
var current;
var displaying;
var monthHeaders = document.querySelector('.release-months');
var monthlyTable = document.getElementById('monthly-releases');
var monthlyTableBody = monthlyTable.querySelector('tbody');
var allDates = document.querySelectorAll('.release-calendars .release-calendar tbody tr');
var matrixHolder = document.querySelector('.all-releases-table');
var today = new Date();
var arrows = document.querySelectorAll('.change-month');
var leftArrow = arrows[0];
var rightArrow = arrows[1];
var viewSelector = document.getElementById('view-selector');
var acceptableFilters = ['bbki', 'cfnai', 'cfsbc', 'deai', 'carts'];

function populateDataReleases() {

    function determineView() {
        var params = {};
        window.location.href.replace(/[?&]+([^=&]+)=([^&]*)/gi, function(m,key,value) {
            params[key] = value;
        });

        if (params.showOnly) {
            params.showOnly = params.showOnly.toLowerCase();
        }
        
        if (acceptableFilters.indexOf(params.showOnly) === -1) {
            for (var i = 0; i < arrows.length; i++) {
                arrows[i].addEventListener('click', changeDate);
            }
            

            viewSelector.addEventListener('change', changeView);
         
            setCurrentDate();
            populateTable(true);

        } else {
            var viewHolder = document.querySelector('.view-control');
            var allReleasesHeader = document.getElementById('all-releases-header');
            var allReleases = document.querySelectorAll('.release-calendars .calendar-holder');
            
            generatedHolder.classList.add('d-none');
            viewHolder.classList.add('d-none');
            allReleasesHeader.classList.add('d-none');
            
            for (var i = 0; i < allReleases.length; i++) {
                if (allReleases[i].id !== params.showOnly + "-holder") {
                    allReleases[i].classList.add('d-none');
                }
            }
        }
    }

    function setCurrentDate() {
        var month = today.getMonth() + 1;
        var year = today.getFullYear() - 2000;
        let selector = '.month-header[data-date="' + month + '-' + year + '"]';
       
        var newCurrent = document.querySelector(selector);
        current = newCurrent;
        newCurrent.dataset.position = 'first';
        newCurrent.classList.add('currently-selected');
        displaying = newCurrent.dataset.date;
    }

    function populateRow(date) {
       
        var html = '';
        var cols = date.querySelectorAll('td');
        var releaseDate = cols[0].innerText;
        var released = today > new Date(releaseDate + ' 23:59');
        var releasedIndicator = released ? '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24.532" height="24.017" viewbox="0 0 5333 5221"><image x="2" width="5330" height="5221" xlink:href="data:img/png;base64,"></image></svg>' : '';
        var dataName = date.parentNode.dataset.name;

        html += "<tr>";
        html +=     "<td>" + dataName + "</td>";
        html +=     "<td>" + releaseDate + "</td>";
        html +=     "<td>" + cols[1].innerText + "</td>";
        html +=     "<td>" + releasedIndicator + "</td>";
        html += "</tr>";
        
        return html;
    }

    function populateTable(initial) {
        var monthlyTableHTML = "";
        var releases = [];
        
        if (!initial) {
            monthlyTableBody.innerHTML = "";
        }
        
        for (var i = 0; i < allDates.length; i++) {
            var date = allDates[i];
            var releaseDate = date.querySelector('td');
            if (initial && today > new Date(releaseDate.innerText + ' 23:59')) {
                date.classList.add('d-none');
            }
            
            if (date.dataset.date === displaying) {
                releases.push(date);
            }
        }
        
        releases.sort(function(a, b) {
            return new Date(a.querySelector('td').innerText) - new Date(b.querySelector('td').innerText);
        });
        
        releases.forEach(function(date) {
            monthlyTableHTML += populateRow(date, monthlyTableHTML);
        });
        
        monthlyTableBody.insertAdjacentHTML('afterbegin', monthlyTableHTML);
        monthlyTable.classList.remove('d-none');
    }

    function changeDate(e) {
        var button = e.currentTarget;
        var direction = button.dataset.direction;
        var next = getNextNumber(displaying, direction);
        var nextMonth = document.querySelector('.month-header[data-date="' + next + '"]');
        
        if (current.dataset.position === 'first' || current.dataset.position === 'last') {
            var disabled = document.querySelector('button.disabled');
            disabled.classList.remove('disabled');
            disabled.disabled = false;
        }
        
        if (nextMonth.dataset.position === 'first' || nextMonth.dataset.position === 'last') {
            var buttonDirection = nextMonth.dataset.position === 'first' ? 'left' : 'right';
            var buttonToDisable = document.querySelector('button[data-direction="' + buttonDirection + '"]');
            buttonToDisable.classList.add('disabled');
            buttonToDisable.disabled = true;
        }
        
        current.classList.remove('currently-selected');
        nextMonth.classList.add('currently-selected');
        current = nextMonth;
        displaying = current.dataset.date;
        
        populateTable(false);
    }

    function getNextNumber(date, direction) {
        var parts = date.split('-');
        var increment = direction === 'right' ? 1 : -1;
        if (parts[0] === '12' && direction === 'right') {
            return '1-' + (parseInt(parts[1]) + 1);
        }
        
        if (parts[0] === '1' && direction === 'left') {
            return '12-' + (parseInt(parts[1]) - 1);
        }
        
        return (parseInt(parts[0]) + increment) + '-' + parts[1];
    }

    function populateAllReleasesTable() {
        var headers = document.querySelectorAll('.month-header');
    
        var matrixBody = document.querySelector('table#release-matrix tbody');
        
        // We only want to go through and populate the table once. If it's already been populated, just un-hide everything
        if (!matrixBody.querySelector('tr')) {
            var bbki = document.getElementById('bbki-table');
            var cfnai = document.getElementById('cfnai-table');
            var cfsbc = document.getElementById('cfsbc-table');
            var deai = document.getElementById('deai-table');
          var nfci = document.getElementById('nfci-table');
            var carts = document.getElementById('carts-table');
            var tableHTML = "";
            
            for (var i = 0; i < headers.length; i++) {
                var date = headers[i].dataset.date;
                tableHTML += "<tr>";
                tableHTML += "<td>" + headers[i].innerText.replace(' Releases', '') + "</td>";
                tableHTML += populateAllReleaseRow(bbki.querySelectorAll('[data-date="' + date + '"]'));
                tableHTML += populateAllReleaseRow(cfnai.querySelectorAll('[data-date="' + date + '"]'));
                tableHTML += populateAllReleaseRow(cfsbc.querySelectorAll('[data-date="' + date + '"]'));
                tableHTML += populateAllReleaseRow(deai.querySelectorAll('[data-date="' + date + '"]'));
              tableHTML += populateAllReleaseRow(nfci.querySelectorAll('[data-date="' + date + '"]'));
                tableHTML += populateAllReleaseRow(carts.querySelectorAll('[data-date="' + date + '"]'));
                tableHTML += "</tr>";
            }
            
            matrixBody.insertAdjacentHTML('afterbegin', tableHTML);
        }
        
        monthlyTable.classList.add('d-none');
        monthHeaders.classList.add('d-none');
        matrixHolder.classList.remove('d-none');
    }

    function populateAllReleaseRow(dates) {
        if (dates.length > 0) {
            var html = "<td>";
            for (var i = 0; i < dates.length; i++) {
                var col = dates[i].querySelector('td');
                html += col.innerText;
                if (i < (dates.length - 1)) {
                    html += "<br />";
                }
            }
            return html += "</td>";
        }
        
        return "<td>&mdash;</td>";
    }

    function revertToMonthView() {
        populateTable();
        monthlyTable.classList.remove('d-none');
        monthHeaders.classList.remove('d-none');
        matrixHolder.classList.add('d-none');
    }

    function changeView(e) {
        if (e.currentTarget.value === 'all-releases') {
            unHideIfHidden();
            return populateAllReleasesTable();
        }
        if (e.currentTarget.value === 'release') {
            return generatedHolder.classList.add('d-none');
        }
        
        unHideIfHidden();
        return revertToMonthView();
    }

    function unHideIfHidden() {
        if (generatedHolder.classList.contains('d-none')) {
            generatedHolder.classList.remove('d-none');
        }
    }

    determineView();
}
populateDataReleases();
                </script>


